# Copy to `.env` and fill in real values. `.env` is git-ignored - never commit it.

# development | test | production
APP_ENV=development
LOG_LEVEL=INFO
# true = one JSON object per log line (recommended in production)
LOG_JSON=false
# Expose /docs and /redoc (OpenAPI UI)
DOCS_ENABLED=true

# PostgreSQL connection (async driver). Example:
# postgresql+asyncpg://<user>:<password>@<host>:5432/<database>
DATABASE_URL=
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_ECHO=false

# Only used by the test suite. The database name MUST end with "_test";
# the suite drops and recreates its schema.
TEST_DATABASE_URL=

# JWT signing secret: at least 32 characters. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_ISSUER=stt-backend
JWT_AUDIENCE=stt-frontend

# Comma-separated list of allowed browser origins (CORS; later also WebSocket Origin checks)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Login brute-force protection (per client IP + email, in-memory)
LOGIN_RATE_LIMIT_ENABLED=true
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60

# --- Speech provider ---
# whisper     = local faster-whisper (default; uses the WHISPER_* settings below)
# gemini_live = Google Gemini Live API (cloud; needs GEMINI_API_KEY, no local model)
SPEECH_PROVIDER=whisper

# --- Gemini Live (only read when SPEECH_PROVIDER=gemini_live) ---
# SERVER-SIDE SECRET. Set it in your host's secret store (e.g. a Render environment
# variable), never in this file, the frontend, or git. Leave empty for Whisper.
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=gemini-3.5-transcribe-live
# Recording limit with Gemini (its live sessions last at most 10 minutes): 10..600 seconds.
# WS_MAX_RECORDING_SECONDS still applies to Whisper and is not changed by this.
GEMINI_MAX_SESSION_SECONDS=600
GEMINI_CONNECT_TIMEOUT_SECONDS=10
# After the last audio: how long to wait for Gemini's pending final transcripts
GEMINI_FINALIZE_TIMEOUT_SECONDS=10

# --- Speech recognition (faster-whisper; only when SPEECH_PROVIDER=whisper) ---
# Multilingual model only (English-only *.en / distil-* models are rejected).
# tiny | base | small | medium | large-v3 | large-v3-turbo, a HF repo id, or a local path
WHISPER_MODEL=small
# cpu | cuda | auto
WHISPER_DEVICE=cpu
# auto = int8 on CPU, float16 on CUDA
WHISPER_COMPUTE_TYPE=auto
# 0 = CTranslate2 default
WHISPER_CPU_THREADS=0
WHISPER_NUM_WORKERS=1
# Model cache directory (default: ~/.cache/huggingface). Keep it outside the repository.
WHISPER_DOWNLOAD_ROOT=
# true = never download; fail if the model is not already cached
WHISPER_LOCAL_FILES_ONLY=false
# Decoding strategy for "mixed" mode: hi_prompted | hi | auto | multilingual
WHISPER_MIXED_STRATEGY=hi_prompted

# --- Live transcription WebSocket (/ws/transcribe) ---
# The browser Origin must be listed in CORS_ALLOWED_ORIGINS (above).
WS_ALLOW_MISSING_ORIGIN=false
WS_AUTH_TIMEOUT_SECONDS=5
WS_IDLE_TIMEOUT_SECONDS=30
WS_MAX_FRAME_BYTES=65536
WS_MAX_TEXT_BYTES=4096
WS_MAX_RECORDING_SECONDS=1800
# Concurrent recordings per server process
WS_MAX_ACTIVE_SESSIONS=3
# Audio may arrive at most this much faster than real time (after the burst allowance)
WS_AUDIO_RATE_FACTOR=1.5
WS_AUDIO_BURST_SECONDS=5
WS_SHUTDOWN_TIMEOUT_SECONDS=30

# --- Inference runtime ---
# Concurrent Whisper jobs shared by all recordings. Startup fails unless
# INFERENCE_CONCURRENCY x WHISPER_CPU_THREADS <= vCPUs - 1 (one core for the event loop).
INFERENCE_CONCURRENCY=1
INFERENCE_ALLOW_CPU_OVERSUBSCRIPTION=false
# Load the model at startup (recommended in production) instead of on first use
SPEECH_PRELOAD_MODEL=false

# Optional real-time pipeline overrides: REALTIME_<FIELD>=value for any RealtimeConfig field,
# e.g. REALTIME_END_SILENCE_MS=800, REALTIME_SHORT_BURST_MIN_FRAMES=5
